rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ])
      );
    }

    function isInstructor() {
      return isAuthenticated() && (
        request.auth.token.instructor == true ||
        request.auth.token.role == 'instructor'
      );
    }

    function canInstructorEditCourse(courseId) {
      let c = get(/databases/$(database)/documents/courses/$(courseId));
      return c != null && c.data.ownerId == request.auth.uid && c.data.status != 'published';
    }

    function canInstructorEditDraft(courseId) {
      let d = get(/databases/$(database)/documents/courseDrafts/$(courseId));
      return d != null && d.data.ownerId == request.auth.uid;
    }

    // User profiles - prevent role escalation by non-admins
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('admin' in request.resource.data) || request.resource.data.admin == false)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'admin']))
      );
      allow delete: if isAdmin();
    }

    // Instructor Applications Lifecycle
    match /instructorApplications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        isOwner(userId) &&
        resource.data.status in ['rejected', 'changes_requested'] &&
        request.resource.data.status == 'pending'
      );
      allow delete: if isAdmin();
    }

    // Live Courses & Content
    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.status == 'published' || (isInstructor() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || (
        isInstructor() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status in ['draft', 'in_review']
      );
      allow update: if isAdmin() || (
        isInstructor() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        resource.data.status != 'published' &&
        request.resource.data.status in ['draft', 'in_review', 'changes_requested'] &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'publishedAt']))
      );
      allow delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));
      }

      match /lessons/{lessonId} {
        allow read: if isAdmin() || resource.data.status == 'published' || (isInstructor() && canInstructorEditCourse(courseId));
        allow write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));

        match /questions/{qId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));
        }

        match /answerKeys/{qId} {
          allow read, write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));
        }
      }

      match /examQuestions/{qId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));
      }

      match /examKeys/{qId} {
        allow read, write: if isAdmin() || (isInstructor() && canInstructorEditCourse(courseId));
      }
    }

    // Revision Drafts for Published Courses (Staged until Admin Approval)
    match /courseDrafts/{courseId} {
      allow read: if isAdmin() || (isInstructor() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || (isInstructor() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (
        isInstructor() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAdmin() || (isInstructor() && resource.data.ownerId == request.auth.uid);

      match /{allChildren=**} {
        allow read, write: if isAdmin() || (isInstructor() && canInstructorEditDraft(courseId));
      }
    }

    // Review Requests & Revision Approval Queue
    match /reviewRequests/{requestId} {
      allow read: if isAdmin() || (isInstructor() && resource.data.instructorId == request.auth.uid);
      allow create: if isAdmin() || (
        isInstructor() &&
        request.resource.data.instructorId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (
        isInstructor() &&
        resource.data.instructorId == request.auth.uid &&
        request.resource.data.instructorId == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedAt', 'reviewedBy']))
      );
      allow delete: if isAdmin();
    }

    // Audit Log (Read by Admin; Written exclusively by Cloud Functions)
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Enrollments (Read by owner/admin, created/updated via Cloud Functions or Admin)
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Student Progress - students cannot forge final exam passage or certificate linkage
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        (!('finalExamPassed' in request.resource.data) || request.resource.data.finalExamPassed == false) &&
        (!('certified' in request.resource.data) || request.resource.data.certified == false) &&
        (!('certificateId' in request.resource.data))
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['finalExamPassed', 'certified', 'certificateId']))
      );
      allow delete: if isAdmin();
    }

    // Exam Attempts - prevent forged final exam results; grading handled server-side / admin
    match /examAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        (
          (request.resource.data.type == 'module_assessment') ||
          (request.resource.data.type == 'final_exam' &&
           (!('passed' in request.resource.data) || request.resource.data.passed == null || request.resource.data.passed == false) &&
           (!('scorePercent' in request.resource.data) || request.resource.data.scorePercent == null))
        )
      );
      allow update, delete: if isAdmin();
    }

    // Certificates - Public read for instant verification; writes strictly reserved for Admin or Server Admin SDK
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Posts & Polls (Public read, logged-in user create/vote, admin approval)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        (isAdmin() && request.resource.data.status in ['approved', 'pending']) ||
        (!isAdmin() && request.resource.data.status == 'pending' && request.resource.data.authorId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.status == resource.data.status
        )
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Blog Posts & Articles (Public read, admin-only write)
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact & Inquiry Messages (Public create, Admin manage)
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
