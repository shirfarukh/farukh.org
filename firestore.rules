rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Courses & Content
    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /lessons/{lessonId} {
        allow read: if isAdmin() || resource.data.status == 'published';
        allow write: if isAdmin();

        match /questions/{qId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin();
        }

        match /answerKeys/{qId} {
          allow read, write: if isAdmin();
        }
      }

      match /examQuestions/{qId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /examKeys/{qId} {
        allow read, write: if isAdmin();
      }
    }

    // Enrollments (Read by owner/admin, created/updated via Cloud Functions or Admin)
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Student Progress (Read and written by owner or admin)
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Exam Attempts (Read and written by owner or admin)
    match /examAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Certificates (Read by anyone if unrevoked or owner/admin, written ONLY by server/admin)
    match /certificates/{certificateId} {
      allow read: if true; // Public verification allowed
      allow write: if isAdmin();
    }

    // Community Posts & Polls (Public read, logged-in user create/vote, admin approval)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        (isAdmin() && request.resource.data.status in ['approved', 'pending']) ||
        (!isAdmin() && request.resource.data.status == 'pending' && request.resource.data.authorId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.status == resource.data.status
        )
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Blog Posts & Articles (Public read, admin-only write)
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

