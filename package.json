{
  "name": "learning-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "type-check": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js",
    "emulators": "firebase emulators:start --only auth,database,firestore,functions,storage,hosting",
    "seed": "npx ts-node scripts/seed.ts",
    "make-admin": "npx ts-node scripts/make-admin.ts",
    "deploy:web": "npm run export:web && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules,database"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.38.0",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "firebase": "^10.12.0",
    "i18next": "^23.11.5",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.51.5",
    "react-i18next": "^14.1.2",
    "react-native": "0.88.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^3.0.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/react": "~19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.10.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
