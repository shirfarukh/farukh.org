{
  "name": "learning-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "type-check": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:rules": "jest tests/rules.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage,hosting",
    "seed": "npx ts-node scripts/seed.ts",
    "make-admin": "npx ts-node scripts/make-admin.ts",
    "deploy:web": "npm run export:web && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.38.0",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^10.12.0",
    "i18next": "^23.11.5",
    "lucide-react-native": "^0.378.0",
    "nativewind": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.51.5",
    "react-i18next": "^14.1.2",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.13.0",
    "react-native-youtube-iframe": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^3.0.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
