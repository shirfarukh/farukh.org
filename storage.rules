rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'shir@secureai.be',
          'admin@example.com',
          'admin@farukh.org',
          'shirfarukh@gmail.com',
          'shir@farukh.org',
          'farukh@farukh.org',
          'info@farukh.org'
        ])
      );
    }

    // Public viewable course covers and certificates
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
